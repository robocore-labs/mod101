<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mod101_harness</name>
  <version>0.0.0</version>
  <description>
    Optional overlay: stands the mod101 arm on the camera-tower test harness
    (extrusion base, tower, actuated pan/tilt head, RealSense depth camera).
    Reuses mod101's arm description and controllers unchanged; adds only the
    harness structure, the pan/tilt joints and the depth camera. Self-contained
    - carries the harness meshes and the raw CAD export it was ported from.
  </description>
  <maintainer email="cristian@robocore.dev">Cristian</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- the arm + the pieces this overlay reuses verbatim -->
  <exec_depend>mod101_description</exec_depend>
  <exec_depend>mod101_control</exec_depend>
  <exec_depend>mod101_gazebo</exec_depend>
  <exec_depend>mod101_moveit_config</exec_depend>
  <exec_depend>mod101_tool_jaws</exec_depend>
  <exec_depend>mod101_tool_parallel</exec_depend>
  <exec_depend>mod101_tool_pincopen</exec_depend>
  <exec_depend>mod101_tool_none</exec_depend>

  <!-- sim + control runtime -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>mock_components</exec_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
