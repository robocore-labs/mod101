<?xml version="1.0" ?>
<!--
  Gazebo extensions for the harness body: per-link visual/friction, plus the
  depth camera (RGBD) sensor on the RealSense.

  Pattern mirrors mod101_description/urdf/mod101.gazebo (gz_link helper + the
  wrist-camera <sensor> block).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="harness_gazebo" params="prefix:=''">

  <!-- The same three-way split the arm uses (mod101_description/urdf/
       materials.xacro), not a second palette: extrusion is `silver`, every
       bracket / adapter / camera body is dark grey, servo housings are black.
       These Gazebo names have to track the URDF <material> on the same link —
       the URDF colour is what RViz and the configurator's 3D preview draw, this
       one is what Gazebo draws, and a mismatch means the robot looks like two
       different robots depending on which window you are in. -->
  <xacro:property name="silver_color"   value="Gazebo/Silver"/>
  <xacro:property name="darkgrey_color" value="Gazebo/DarkGrey"/>
  <xacro:property name="black_color"    value="Gazebo/Black"/>

  <xacro:macro name="hz_link" params="name color">
    <gazebo reference="${prefix}${name}">
      <material>${color}</material>
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <self_collide>true</self_collide>
    </gazebo>
  </xacro:macro>

  <!-- 2020 extrusion: the base rail. -->
  <gazebo reference="${prefix}base_link">
    <material>${silver_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>true</self_collide>
    <gravity>true</gravity>
  </gazebo>

  <!-- extrusion -->
  <xacro:hz_link name="tower_1"            color="${silver_color}"/>
  <xacro:hz_link name="back_1"             color="${silver_color}"/>
  <!-- brackets and adapters -->
  <xacro:hz_link name="mod_101_adapter_1"  color="${darkgrey_color}"/>
  <xacro:hz_link name="yaw_bracket_1"      color="${darkgrey_color}"/>
  <xacro:hz_link name="yaw_mount_1"        color="${darkgrey_color}"/>
  <xacro:hz_link name="pitch_link__1"      color="${darkgrey_color}"/>
  <!-- servo housings -->
  <xacro:hz_link name="yaw_servo_1"        color="${black_color}"/>
  <xacro:hz_link name="pitch_servo_1"      color="${black_color}"/>

  <!-- Depth camera. rgbd_camera publishes color image, depth image, camera_info
       and a registered point cloud under <topic>. Stamp with the optical frame
       so ROS consumers see REP-103 axes.

       THE <pose> IS LOAD-BEARING. Gazebo aims a camera sensor along its own +X
       (with +Z up), and the sensor inherits the link frame unless posed. The
       RealSense lens looks along realsense_1 -Y, not +X (see the optical-frame
       note in harness_body.xacro for the mesh measurements), so without this
       -90 deg yaw the simulated camera renders a view 90 deg off the real one,
       while TF still says it points at -Y. The yaw maps sensor +X -> link -Y
       and leaves sensor +Z on link +Z, so the image is upright and agrees with
       ${prefix}realsense_optical_frame. -->
  <gazebo reference="${prefix}realsense_1">
    <material>${darkgrey_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>true</self_collide>

    <sensor name="${prefix}depth_camera" type="rgbd_camera">
      <pose>0 0 0 0 0 -1.570796</pose>
      <topic>harness/depth_camera</topic>
      <gz_frame_id>${prefix}realsense_optical_frame</gz_frame_id>
      <update_rate>30</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov> <!-- ~60 deg -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</xacro:macro>

</robot>
