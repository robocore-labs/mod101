<?xml version="1.0" ?>
<!--
  Vendored harness geometry (extrusion base + camera tower + 2-axis pan/tilt
  head + RealSense).

  PROVENANCE: hand-ported from the raw CAD export kept verbatim at
    export/mod101_harness.raw.xacro
  xacro `include` is a literal XML merge with no way to *omit* a link, and this
  package needs to (a) drop the stand-in `mod_101_base_1` so the real mod101 arm
  can take its place, (b) actuate the pan/tilt joints, (c) supply its own
  materials / gazebo / ros2_control. So the ~200 lines of body are ported here.
  MESHES ARE NOT DUPLICATED — every <mesh> resolves against
  $(find mod101_harness)/meshes (shared with the raw export).

  REGENERATE this file (re-apply the deltas below) whenever the harness is
  re-exported: replace export/mod101_harness.raw.xacro + meshes/, then port.

  Deltas vs the export:
    - wrapped in <xacro:macro name="harness_body" params="prefix:=''">
    - removed link `mod_101_base_1` and joint `Rigid 29` (the stand-in base)
    - removed the self-contained <xacro:include> of materials/gazebo/ros2control
    - `Revolute 18` -> `${prefix}pan_joint`, now `revolute` + limits
    - `Revolute 20` -> `${prefix}tilt_joint`, now `revolute` + limits; axis kept
      on the export's X, sign flipped to +X so positive tilt looks down
    - materials: the export painted every part `silver`. Now the harness reads
      like the arm does, using the SAME palette (mod101_description/urdf/
      materials.xacro) rather than a second one: `silver` for extrusion,
      `body_darkgrey` for brackets/adapters/the camera body, `motor_black` for
      servo housings.
    - added `${prefix}realsense_optical_frame` (REP-103 optical axes, +Z along
      the -Y boresight)
    - every link/joint name is `${prefix}`-scoped
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="harness_body" params="prefix:=''">

<link name="${prefix}base_link">
  <inertial>
    <origin xyz="0.7183668847290359 -0.1898371852815478 -0.018503159635172448" rpy="0 0 0"/>
    <mass value="0.4359046662837625"/>
    <inertia ixx="3.7e-05" iyy="0.003738" izz="0.003738" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="${prefix}yaw_bracket_1">
  <inertial>
    <origin xyz="-0.24048767950999106 0.02833424258398279 -0.10053283234598204" rpy="0 0 0"/>
    <mass value="0.01768001501876205"/>
    <inertia ixx="4e-06" iyy="3e-06" izz="1e-06" ixy="-0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-1.116019 0.218172 -0.374755" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/yaw_bracket_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="body_darkgrey"/>
  </visual>
  <collision>
    <origin xyz="-1.116019 0.218172 -0.374755" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/yaw_bracket_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="${prefix}yaw_servo_1">
  <inertial>
    <origin xyz="-0.01626256682350069 -0.010250178675302313 -0.015852716380520993" rpy="0 0 0"/>
    <mass value="0.2781207151088369"/>
    <inertia ixx="3.8e-05" iyy="7.1e-05" izz="6e-05" ixy="-0.0" iyz="0.0" ixz="1e-06"/>
  </inertial>
  <visual>
    <origin xyz="-0.865117 0.179587 -0.289497" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/yaw_servo_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="motor_black"/>
  </visual>
  <collision>
    <origin xyz="-0.865117 0.179587 -0.289497" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/yaw_servo_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="${prefix}yaw_mount_1">
  <inertial>
    <origin xyz="-0.0008752813552826977 3.643010852427686e-07 0.002835565808725571" rpy="0 0 0"/>
    <mass value="0.01768001501876205"/>
    <inertia ixx="1e-06" iyy="3e-06" izz="4e-06" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.836117 0.189837 -0.292697" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/yaw_mount_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="body_darkgrey"/>
  </visual>
  <collision>
    <origin xyz="-0.836117 0.189837 -0.292697" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/yaw_mount_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="${prefix}pitch_servo_1">
  <inertial>
    <origin xyz="0.015852602679255368 -0.010250214439629785 0.016262453122235343" rpy="0 0 0"/>
    <mass value="0.2781207151088369"/>
    <inertia ixx="6e-05" iyy="7.1e-05" izz="3.8e-05" ixy="0.0" iyz="-0.0" ixz="1e-06"/>
  </inertial>
  <visual>
    <origin xyz="-0.819967 0.179587 -0.305947" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/pitch_servo_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="motor_black"/>
  </visual>
  <collision>
    <origin xyz="-0.819967 0.179587 -0.305947" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/pitch_servo_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="${prefix}pitch_link__1">
  <inertial>
    <origin xyz="-0.018217940621004014 -0.00292124752604056 0.018998095012473626" rpy="0 0 0"/>
    <mass value="0.14731389111767698"/>
    <inertia ixx="2.7e-05" iyy="7.5e-05" izz="5.8e-05" ixy="-0.0" iyz="3e-06" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.854017 0.189837 -0.334947" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/pitch_link__1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="body_darkgrey"/>
  </visual>
  <collision>
    <origin xyz="-0.854017 0.189837 -0.334947" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/pitch_link__1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="${prefix}realsense_1">
  <inertial>
    <origin xyz="-0.021091708113011975 -0.011657624516847098 -2.35569412897485e-05" rpy="0 0 0"/>
    <mass value="0.0720014321602746"/>
    <inertia ixx="7e-06" iyy="4.6e-05" izz="4.7e-05" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.858317 0.200337 -0.367343" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/realsense_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="body_darkgrey"/>
  </visual>
  <collision>
    <origin xyz="-0.858317 0.200337 -0.367343" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/realsense_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<!-- Optical frame for the depth camera: REP-103 (+Z out of the lens, +X right,
     +Y down). The lens looks along realsense_1 -Y. Evidence, from the meshes:
     realsense_1 is 89.8 x 25.1 x 25.0 mm - a D435, whose 90 mm dimension is the
     stereo baseline, and it lies along X, so X cannot be the viewing axis. And
     1313 mm^2 of the camera's +Y face is flat and coplanar with 1593 mm^2 of
     pitch_link__1's -Y face at Y=-200.34, with the whole bracket behind that
     plane: +Y is the bolted mounting face, so the lens faces -Y.

     This frame therefore maps optical +Z -> -Y (forward), +Y -> -Z (down),
     +X -> -X (right, with the camera upright: nothing in the chain carries a
     roll, so link +Z is up). It previously used the arm wrist camera's rotation
     (rpy -pi/2 0 -pi/2), which aims +Z along +X - 90 deg off, which is what
     made the head look like it pointed the wrong way.

     Zero translation - lens offset within the body link not measured; fix here
     if metric accuracy is needed. -->
<link name="${prefix}realsense_optical_frame"/>
<joint name="${prefix}realsense_optical_joint" type="fixed">
  <origin xyz="0 0 0" rpy="-1.570796 0 3.141593"/>
  <parent link="${prefix}realsense_1"/>
  <child link="${prefix}realsense_optical_frame"/>
</joint>

<link name="${prefix}mod_101_adapter_1">
  <inertial>
    <origin xyz="0.3290322101958174 -0.013258210571603646 0.07482693375623085" rpy="0 0 0"/>
    <mass value="0.5806071982549674"/>
    <inertia ixx="0.000181" iyy="0.000387" izz="0.000507" ixy="0.0" iyz="0.0" ixz="1e-06"/>
  </inertial>
  <visual>
    <origin xyz="-0.320033 0.316579 0.090851" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/mod_101_adapter_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="body_darkgrey"/>
  </visual>
  <collision>
    <origin xyz="-0.320033 0.316579 0.090851" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/mod_101_adapter_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="${prefix}tower_1">
  <inertial>
    <origin xyz="0.010000022826068933 0.009999792166619115 0.15999970226778837" rpy="0 0 0"/>
    <mass value="0.4359046662837625"/>
    <inertia ixx="0.003738" iyy="0.003738" izz="3.7e-05" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.878367 0.199837 0.028503" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/tower_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.878367 0.199837 0.028503" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/tower_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="${prefix}back_1">
  <inertial>
    <origin xyz="-0.2932579855783596 -0.44833419350146253 0.07234785241212485" rpy="0 0 0"/>
    <mass value="0.2451971061160035"/>
    <inertia ixx="0.000672" iyy="2.1e-05" izz="0.000672" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.941625 -0.158497 0.090851" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/back_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="-0.941625 -0.158497 0.090851" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_harness)/meshes/back_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="${prefix}Rigid_12" type="fixed">
  <origin xyz="0.237652 -0.018335 0.403258" rpy="0 0 0"/>
  <parent link="${prefix}tower_1"/>
  <child link="${prefix}yaw_bracket_1"/>
</joint>

<joint name="${prefix}Rigid_17" type="fixed">
  <origin xyz="-0.250902 0.038585 -0.085258" rpy="0 0 0"/>
  <parent link="${prefix}yaw_bracket_1"/>
  <child link="${prefix}yaw_servo_1"/>
</joint>

<!-- PAN (yaw). Was `continuous` in the export; bounded to real servo travel so
     MoveIt has a sample interval for the pan_tilt group. Axis +Z. -->
<joint name="${prefix}pan_joint" type="revolute">
  <origin xyz="-0.029 -0.01025 0.0032" rpy="0 0 0"/>
  <parent link="${prefix}yaw_servo_1"/>
  <child link="${prefix}yaw_mount_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit lower="-1.570796" upper="1.570796" effort="5" velocity="3.0"/>
  <dynamics damping="0.05" friction="0.05"/>
</joint>

<joint name="${prefix}Rigid_19" type="fixed">
  <origin xyz="-0.01615 0.01025 0.01325" rpy="0 0 0"/>
  <parent link="${prefix}yaw_mount_1"/>
  <child link="${prefix}pitch_servo_1"/>
</joint>

<!-- TILT (pitch). Was `continuous`; bounded like the pan joint.
     AXIS IS X, WHICH IS WHAT THE CAD EXPORT SAID. An earlier edit here changed
     it to +Y on the premise that the RealSense boresight is +X. That premise is
     wrong, and +Y is the one axis that breaks this joint completely: the true
     boresight is -Y (see the sensor note on realsense_1), so rotating about +Y
     spins the camera about its own optical axis. Tilt was pure image ROLL — the
     head could not be aimed up or down at all, at any commanded value.

     Measured from the meshes, which settle it without a re-export. Both servos
     are the same 45.22 x 24.72 x 37.80 part (identical STLs, rotated 90 deg),
     and each joint origin lands exactly on that servo's output face, centred on
     the other two axes:
       pan_joint  is 0.00 mm from yaw_servo_1   Z-max  -> shaft along Z
       tilt_joint is 0.55 mm from pitch_servo_1 X-max  -> shaft along X
     A shaft is normal to the face it emerges from, so the tilt axis is X. It is
     also perpendicular to the -Y boresight, as a pan/tilt requires; +Y was not.

     SIGN is ours, not the CAD's: the export says `-1 0 0`, which would make
     positive tilt look UP. Positive = DOWN is kept here (aerospace pitch, and
     what the pan_tilt group and profiles/mod101_harness.yaml are commanded
     with), so the axis is +X. Only the sign differs from the export. -->
<joint name="${prefix}tilt_joint" type="revolute">
  <origin xyz="0.03405 -0.01025 0.029" rpy="0 0 0"/>
  <parent link="${prefix}pitch_servo_1"/>
  <child link="${prefix}pitch_link__1"/>
  <axis xyz="1.0 0.0 0.0"/>
  <limit lower="-1.396263" upper="1.396263" effort="5" velocity="3.0"/>
  <dynamics damping="0.05" friction="0.05"/>
</joint>

<joint name="${prefix}Rigid_21" type="fixed">
  <origin xyz="0.0043 -0.0105 0.032396" rpy="0 0 0"/>
  <parent link="${prefix}pitch_link__1"/>
  <child link="${prefix}realsense_1"/>
</joint>

<joint name="${prefix}Rigid_28" type="fixed">
  <origin xyz="-0.621592 -0.475076 0.0" rpy="0 0 0"/>
  <parent link="${prefix}back_1"/>
  <child link="${prefix}mod_101_adapter_1"/>
</joint>

<joint name="${prefix}Rigid_30" type="fixed">
  <origin xyz="0.878367 -0.199837 -0.028503" rpy="0 0 0"/>
  <parent link="${prefix}base_link"/>
  <child link="${prefix}tower_1"/>
</joint>

<joint name="${prefix}Rigid_31" type="fixed">
  <origin xyz="0.941625 0.158497 -0.090851" rpy="0 0 0"/>
  <parent link="${prefix}base_link"/>
  <child link="${prefix}back_1"/>
</joint>

</xacro:macro>

</robot>
