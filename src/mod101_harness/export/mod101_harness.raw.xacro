<?xml version="1.0" ?>
<robot name="mod101_harness" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!--
  RAW CAD EXPORT, kept verbatim (harness alone + a stand-in mod_101_base_1 that
  marks where the arm bolts on). NOT built by anything: the live description is
  the ported urdf/harness_body.xacro. Kept only as the re-export baseline and to
  document the untouched joint origins/axes. See urdf/harness_body.xacro header.
-->
