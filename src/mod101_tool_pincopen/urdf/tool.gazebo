<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo reference="pincopen_base_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="pincopen_right_arm">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="pincopen_left_arm">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <!-- Bumped friction on the fingertips — they're the contact surface. -->
  <gazebo reference="pincopen_right_finger">
    <material>Gazebo/Silver</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="pincopen_left_finger">
    <material>Gazebo/Silver</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <self_collide>true</self_collide>
  </gazebo>

</robot>
