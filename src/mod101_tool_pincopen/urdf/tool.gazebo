<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="mod101_tool_pincopen_gazebo" params="prefix:=''">

  <gazebo reference="${prefix}pincopen_base_link">
    <material>Gazebo/Green</material>
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="${prefix}pincopen_right_arm">
    <material>Gazebo/Green</material>
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="${prefix}pincopen_left_arm">
    <material>Gazebo/Green</material>
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <!-- Bumped friction on the fingertips — they're the contact surface. -->
  <gazebo reference="${prefix}pincopen_right_finger">
    <material>Gazebo/Silver</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <self_collide>true</self_collide>
  </gazebo>

  <gazebo reference="${prefix}pincopen_left_finger">
    <material>Gazebo/Silver</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <self_collide>true</self_collide>
  </gazebo>

</xacro:macro>

</robot>
