<?xml version="1.0" ?>
<!--
  PincOpen pincer gripper, wrapped as a mod101 tool. Geometry vendored from
  CNURobotics/pinc_open_driver (MIT). Differences vs upstream:

    * link names prefixed `pincopen_` to avoid collision with mod101's own
      `base_link` and to keep namespaces tidy.
    * active joint renamed from `gripper` -> `6` to match mod101's joint-id
      convention (arm uses 1-5, tool uses 6).
    * single-active-joint design preserved: `6` is revolute, the four arm/
      finger joints follow via URDF <mimic> (works under bullet-featherstone).
    * mount layered per docs/tool-convention.md:
        wrist_flange ─[pincopen_mount, identity]─> pincopen_root
                     ─[pincopen_cad_to_root, identity]─> pincopen_base_link
      (PincOpen's CAD frame already follows the convention so cad_to_root
      is identity; tune that joint if reorientation becomes needed.)
    * minimal inertials added (upstream has none; gz_ros2_control needs them).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:include filename="$(find mod101_tool_pincopen)/urdf/tool.ros2control"/>
<xacro:include filename="$(find mod101_tool_pincopen)/urdf/tool.gazebo"/>

<xacro:macro name="mod101_tool_pincopen" params="prefix:='' use_sim:='true'">

  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

  <!-- ============================================================
       Convention root: at the bolt pattern, +X outward, +Z up.
       The vendored sub-tree starts at `pincopen_base_link`; PincOpen's CAD
       frame happens to match the convention already (link origins coincide
       with the wrist mount, mesh visual_origins are zero) so the
       cad-to-root joint is identity. Tune rpy here if you need to reorient
       the gripper.
       ============================================================ -->

  <link name="${prefix}pincopen_root">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="0" iyz="0" ixz="0"/>
    </inertial>
  </link>

  <joint name="${prefix}pincopen_mount" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="${prefix}wrist_flange"/>
    <child  link="${prefix}pincopen_root"/>
  </joint>

  <joint name="${prefix}pincopen_cad_to_root" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="${prefix}pincopen_root"/>
    <child  link="${prefix}pincopen_base_link"/>
  </joint>

  <!-- ============================================================
       Vendored PincOpen sub-tree
       ============================================================ -->

  <link name="${prefix}pincopen_base_link">
    <inertial>
      <origin xyz="0.029 0 0.005" rpy="0 0 0"/>
      <mass value="0.080"/>
      <inertia ixx="3.0e-05" iyy="6.0e-05" izz="6.0e-05" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mod101_tool_pincopen/meshes/Gripper_Palm_Shell_w_motor_v1.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="accent_green"/>
    </visual>
    <collision>
      <origin xyz="0.029 0 0.0033" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.1 0.0323"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.024 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.048 0.025 0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- Coupler is the driven link; mass kept tiny since it carries no geometry. -->
  <link name="${prefix}pincopen_coupler">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-07" iyy="1e-07" izz="1e-07" ixy="0" iyz="0" ixz="0"/>
    </inertial>
  </link>

  <link name="${prefix}pincopen_right_arm">
    <inertial>
      <origin xyz="0.017 0 0" rpy="0 0 0"/>
      <mass value="0.008"/>
      <inertia ixx="3e-06" iyy="3e-06" izz="3e-06" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mod101_tool_pincopen/meshes/gripper_right_arm.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="accent_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mod101_tool_pincopen/meshes/gripper_right_arm_simple.stl" scale="${mesh_scale}"/>
      </geometry>
    </collision>
  </link>

  <link name="${prefix}pincopen_left_arm">
    <inertial>
      <origin xyz="0.017 0 0" rpy="0 0 0"/>
      <mass value="0.008"/>
      <inertia ixx="3e-06" iyy="3e-06" izz="3e-06" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mod101_tool_pincopen/meshes/gripper_left_arm.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="accent_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mod101_tool_pincopen/meshes/gripper_left_arm_simple.stl" scale="${mesh_scale}"/>
      </geometry>
    </collision>
  </link>

  <link name="${prefix}pincopen_right_finger">
    <inertial>
      <origin xyz="0.012 0 0" rpy="0 0 0"/>
      <mass value="0.006"/>
      <inertia ixx="2e-06" iyy="2e-06" izz="2e-06" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mod101_tool_pincopen/meshes/gripper_right_finger.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mod101_tool_pincopen/meshes/gripper_right_finger_simple.stl" scale="${mesh_scale}"/>
      </geometry>
    </collision>
  </link>

  <link name="${prefix}pincopen_left_finger">
    <inertial>
      <origin xyz="0.012 0 0" rpy="0 0 0"/>
      <mass value="0.006"/>
      <inertia ixx="2e-06" iyy="2e-06" izz="2e-06" ixy="0" iyz="0" ixz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mod101_tool_pincopen/meshes/gripper_left_finger.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mod101_tool_pincopen/meshes/gripper_left_finger_simple.stl" scale="${mesh_scale}"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================
       Joints
       ============================================================ -->

  <!-- Single active joint. Named "6" to match the mod101 numbering. -->
  <joint name="${prefix}6" type="revolute">
    <parent link="${prefix}pincopen_base_link"/>
    <child link="${prefix}pincopen_coupler"/>
    <origin xyz="0.053492 0 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.44" upper="0.0" effort="5" velocity="1"/>
  </joint>

  <joint name="${prefix}pincopen_base_to_right_arm" type="revolute">
    <parent link="${prefix}pincopen_base_link"/>
    <child link="${prefix}pincopen_right_arm"/>
    <origin xyz="0.053492 -0.03250 -0.008" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.22" upper="0.0" effort="5" velocity="1"/>
    <mimic joint="${prefix}6" multiplier="0.5" offset="0.0"/>
  </joint>

  <joint name="${prefix}pincopen_base_to_left_arm" type="revolute">
    <parent link="${prefix}pincopen_base_link"/>
    <child link="${prefix}pincopen_left_arm"/>
    <origin xyz="0.053492 0.03250 -0.008" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="1.22" effort="5" velocity="1"/>
    <mimic joint="${prefix}6" multiplier="-0.5" offset="0.0"/>
  </joint>

  <joint name="${prefix}pincopen_right_arm_to_right_finger" type="revolute">
    <parent link="${prefix}pincopen_right_arm"/>
    <child link="${prefix}pincopen_right_finger"/>
    <origin xyz="0.034641 0.020 -0.0002" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="1.22" effort="5" velocity="1"/>
    <mimic joint="${prefix}6" multiplier="-0.5" offset="0.0"/>
  </joint>

  <joint name="${prefix}pincopen_left_arm_to_left_finger" type="revolute">
    <parent link="${prefix}pincopen_left_arm"/>
    <child link="${prefix}pincopen_left_finger"/>
    <origin xyz="0.034641 -0.020 0.0002" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.22" upper="0.0" effort="5" velocity="1"/>
    <mimic joint="${prefix}6" multiplier="0.5" offset="0.0"/>
  </joint>

  <!-- ============================================================
       ros2_control + gazebo extensions
       ============================================================ -->

<xacro:mod101_tool_pincopen_ros2control prefix="${prefix}" use_sim="${use_sim}"/>
<xacro:mod101_tool_pincopen_gazebo prefix="${prefix}"/>

</xacro:macro>

</robot>
