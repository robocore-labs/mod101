<?xml version="1.0"?>
<!--
  SO-101 jaws hardware block. Single revolute joint, no mimics. In sim runs
  under gz_ros2_control; on real hardware swap for whichever Feetech serial
  bus driver is wired up to the arm (jaw servo lives on the same bus).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="mod101_tool_jaws_ros2control" params="prefix:='' use_sim:='true'">

  <ros2_control name="${prefix}mod101_tool_jaws_system" type="system">

    <xacro:if value="${use_sim}">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
    </xacro:if>
    <xacro:unless value="${use_sim}">
      <hardware>
        <!-- Placeholder: replace with the real bus driver once wired up. -->
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
    </xacro:unless>

    <joint name="${prefix}6">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">2.14</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

  </ros2_control>

</xacro:macro>

</robot>
