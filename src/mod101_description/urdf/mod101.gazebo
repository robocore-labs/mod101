<?xml version="1.0" ?>
<robot name="mod101" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:macro name="mod101_arm_gazebo" params="prefix">

<xacro:property name="body_color" value="Gazebo/DarkGrey" />
<xacro:property name="motor_color" value="Gazebo/Black" />
<xacro:property name="silver_color" value="Gazebo/Silver" />
<xacro:property name="accent_color" value="Gazebo/Green" />

<xacro:macro name="gz_link" params="name color">
  <gazebo reference="${prefix}${name}">
    <material>${color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>true</self_collide>
  </gazebo>
</xacro:macro>

<gazebo reference="${prefix}base_link">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

<xacro:gz_link name="servo_base_1"             color="${motor_color}"/>
<xacro:gz_link name="base_cover_1"             color="${accent_color}"/>
<xacro:gz_link name="shoulder_rotation_link_1" color="${body_color}"/>
<xacro:gz_link name="servo_shoulder_1"         color="${motor_color}"/>
<xacro:gz_link name="shoulder_adapter_1"       color="${body_color}"/>
<xacro:gz_link name="arm_extrusion_1"          color="${silver_color}"/>
<xacro:gz_link name="elbow_link_1"             color="${body_color}"/>
<xacro:gz_link name="servo_elbow_1"            color="${motor_color}"/>
<xacro:gz_link name="elbow_adapter_1"          color="${body_color}"/>
<xacro:gz_link name="forearm_extrusion_1"      color="${silver_color}"/>
<xacro:gz_link name="wrist_servo_adapter_1"    color="${body_color}"/>
<xacro:gz_link name="servo_wrist_tilt_1"       color="${motor_color}"/>
<xacro:gz_link name="wrist_roll_adapter_1"     color="${body_color}"/>
<xacro:gz_link name="servo_wrist_rotation_1"   color="${motor_color}"/>
<xacro:gz_link name="camera_adapter_1"         color="${accent_color}"/>
<xacro:gz_link name="camera_wing_1"            color="${accent_color}"/>

<gazebo reference="${prefix}wrist_camera_v1_1">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>

  <sensor name="${prefix}wrist_camera" type="camera">
    <topic>${prefix}wrist_camera/image_raw</topic>
    <!-- Stamp images with the optical frame, not the body link: ROS
         consumers assume REP-103 optical axes. The sensor still looks
         along the body link's +X, which is where Gazebo aims it. -->
    <gz_frame_id>${prefix}wrist_camera_optical_frame</gz_frame_id>
    <update_rate>30</update_rate>
    <always_on>1</always_on>
    <visualize>true</visualize>
    <camera>
      <horizontal_fov>1.047</horizontal_fov> <!-- ~60 deg -->
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.01</near>
        <far>10.0</far>
      </clip>
    </camera>
  </sensor>
</gazebo>

</xacro:macro>

</robot>
