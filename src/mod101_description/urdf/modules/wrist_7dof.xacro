<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<!-- DESIGN LEDGER: optional 7DOF wrist, extracted from mod101_7DOF.step.
SI units; meshes are link-local mm with scale 0.001. Canonical +X = CAD -Y,
+Y = CAD +X, +Z = CAD +Z. Anchor is the forearm rail tip, from STEP bounds.
The extra joint_wrist_yaw is +Z; pitch remains -Y, roll +X (outward flange).
Joint datums come from servo shaft cylinders and output-horn face planes.
PETG 1270 kg/m3, 15% infill, provisional 1.6 mm shell, CAD A*t shell model;
COM/tensor uniformly scaled to estimated print mass. Servos: assumed STS3215,
56 g each. Servo COM/tensor use its CAD volume distribution. See
config/7dof_measurements.json and tools/export_7dof_wrist.py for provenance.
Empty STEP components wrist_yaw_mount_a/wrist_yaw_link have no solids; omitted.
The solid "elbow_link (1)" is the wrist-yaw output bracket, not the elbow.
Source upstream modules retain the 6DOF arm's frames. This wrist registers at
its rail end; small CAD lateral assembly differences are not upstream redesigns.
New yaw limits +-90 degrees are provisional; effort/velocity conservative
simulation estimates. Every tool still mounts on wrist_flange, joint "6".
-->
<xacro:macro name="mod101_wrist_7dof" params="prefix">
<link name="${prefix}wrist_servo_adapter_1">
  <inertial>
    <origin xyz="-0.0029319183932 0.000255491708402 0.0206079014992" rpy="0 0 0"/>
    <mass value="0.029687654429"/>
    <inertia ixx="1.42685527095e-05" iyy="1.40272170456e-05" izz="4.42806471067e-06" ixy="1.54031667667e-08" ixz="-5.84165395571e-08" iyz="3.11809731599e-08"/>
  </inertial>
  <visual><geometry><mesh filename="package://mod101_description/meshes/wrist_yaw_mount_7dof.stl" scale="0.001 0.001 0.001"/></geometry><material name="body_darkgrey"/></visual>
  <collision><origin xyz="-0.0066725740757 0.000204773498255 0.0249623669323"/><geometry><box size="0.0386548292545 0.0288000002 0.0722246845534"/></geometry></collision>
</link>
<link name="${prefix}servo_wrist_yaw_1">
  <inertial>
    <origin xyz="-0.0127374255131 -1.71018995852e-08 -0.0190526019202" rpy="0 0 0"/>
    <mass value="0.056"/>
    <inertia ixx="7.7305339498e-06" iyy="1.43550475459e-05" izz="1.19967154045e-05" ixy="2.40614626899e-13" ixz="-1.0189936133e-07" iyz="-1.64712572996e-11"/>
  </inertial>
  <visual><geometry><mesh filename="package://mod101_description/meshes/servo_wrist_yaw_7dof.stl" scale="0.001 0.001 0.001"/></geometry><material name="motor_black"/></visual>
  <collision><origin xyz="-0.0124995 6.79456491071e-16 -0.0189"/><geometry><box size="0.045223 0.024723 0.0378"/></geometry></collision>
</link>
<link name="${prefix}wrist_yaw_link_1">
  <inertial>
    <origin xyz="0.0102211478977 -7.87329357999e-05 -0.0309998681581" rpy="0 0 0"/>
    <mass value="0.0261889950925"/>
    <inertia ixx="1.49645878701e-05" iyy="1.54260685568e-05" izz="6.0396428899e-06" ixy="-2.08908681555e-08" ixz="-2.61071110631e-06" iyz="-4.45724659997e-08"/>
  </inertial>
  <visual><geometry><mesh filename="package://mod101_description/meshes/wrist_yaw_link_7dof.stl" scale="0.001 0.001 0.001"/></geometry><material name="body_darkgrey"/></visual>
  <collision><origin xyz="0.00635659880931 -1.64313007645e-15 -0.0315640390648"/><geometry><box size="0.040090058286 0.0403000002 0.0749779937358"/></geometry></collision>
</link>
<link name="${prefix}servo_wrist_tilt_1">
  <inertial>
    <origin xyz="-0.0127377723201 0.0187464851886 -3.65839335984e-07" rpy="0 0 0"/>
    <mass value="0.056"/>
    <inertia ixx="7.72989517588e-06" iyy="1.19970545731e-05" izz="1.43547786027e-05" ixy="-1.01566220586e-07" ixz="1.41833280115e-10" iyz="3.88999882108e-10"/>
  </inertial>
  <visual><geometry><mesh filename="package://mod101_description/meshes/servo_wrist_pitch_7dof.stl" scale="0.001 0.001 0.001"/></geometry><material name="motor_black"/></visual>
  <collision><origin xyz="-0.0124995 0.0189 5.28643795406e-15"/><geometry><box size="0.045223 0.0378 0.024723"/></geometry></collision>
</link>
<link name="${prefix}wrist_roll_adapter_1">
  <inertial>
    <origin xyz="0.0265387277259 0.0191984270174 -0.020868806699" rpy="0 0 0"/>
    <mass value="0.0271150906562"/>
    <inertia ixx="1.60093534881e-05" iyy="1.82017855222e-05" izz="1.29978081331e-05" ixy="7.65847715895e-11" ixz="6.37639225944e-06" iyz="1.37438169832e-09"/>
  </inertial>
  <visual><geometry><mesh filename="package://mod101_description/meshes/wrist_pitch_link_7dof.stl" scale="0.001 0.001 0.001"/></geometry><material name="body_darkgrey"/></visual>
  <collision><origin xyz="0.0256494897928 0.0191999962301 -0.01770000005"/><geometry><box size="0.0732989795856 0.0493000077398 0.0574000001"/></geometry></collision>
</link>
<link name="${prefix}servo_wrist_rotation_1">
  <inertial>
    <origin xyz="-0.0190526019202 1.71019067147e-08 -0.0127374255131" rpy="0 0 0"/>
    <mass value="0.056"/>
    <inertia ixx="1.19967154045e-05" iyy="1.43550475459e-05" izz="7.7305339498e-06" ixy="1.64712574667e-11" ixz="-1.0189936133e-07" iyz="-2.40610595045e-13"/>
  </inertial>
  <visual><geometry><mesh filename="package://mod101_description/meshes/servo_wrist_roll_7dof.stl" scale="0.001 0.001 0.001"/></geometry><material name="motor_black"/></visual>
  <collision><origin xyz="-0.0189 6.96243063203e-15 -0.0124995"/><geometry><box size="0.0378 0.024723 0.045223"/></geometry></collision>
</link>
<joint name="${prefix}fixed_wrist_servo_adapter_1" type="fixed">
  <origin xyz="${forearm_advance} 0 0"/>
  <parent link="${prefix}forearm_extrusion_1"/><child link="${prefix}wrist_servo_adapter_1"/>
</joint>
<joint name="${prefix}fixed_servo_wrist_yaw_1" type="fixed">
  <origin xyz="0.0373579257739 0.000204773498252 0.058074709209"/><parent link="${prefix}wrist_servo_adapter_1"/><child link="${prefix}servo_wrist_yaw_1"/>
</joint>
<joint name="${prefix}joint_wrist_yaw" type="revolute">
  <parent link="${prefix}servo_wrist_yaw_1"/><child link="${prefix}wrist_yaw_link_1"/>
  <axis xyz="0 0 1"/><limit lower="-1.570796326795" upper="1.570796326795" effort="2.94" velocity="1.5"/>
  <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
</joint>
<joint name="${prefix}fixed_servo_wrist_tilt_1" type="fixed">
  <origin xyz="0.037551548695 -0.01865 -0.0556504336543"/><parent link="${prefix}wrist_yaw_link_1"/><child link="${prefix}servo_wrist_tilt_1"/>
</joint>
<joint name="${prefix}joint_wrist_tilt" type="revolute">
  <parent link="${prefix}servo_wrist_tilt_1"/><child link="${prefix}wrist_roll_adapter_1"/>
  <axis xyz="0 -1 0"/><limit lower="-1.23" upper="1.54" effort="100" velocity="100"/>
  <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
</joint>
<joint name="${prefix}fixed_servo_wrist_rotation_1" type="fixed">
  <origin xyz="0.0626 0.0192 -1.20792265079e-14"/><parent link="${prefix}wrist_roll_adapter_1"/><child link="${prefix}servo_wrist_rotation_1"/>
</joint>
<joint name="${prefix}joint_wrist_roll" type="revolute">
  <parent link="${prefix}servo_wrist_rotation_1"/><child link="${prefix}wrist_flange"/>
  <axis xyz="1 0 0"/><limit lower="0" upper="3.141593" effort="100" velocity="100"/>
  <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
</joint>
</xacro:macro>
</robot>
