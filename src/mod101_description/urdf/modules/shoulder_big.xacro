<?xml version="1.0" ?>
<!--
  Shoulder joint module — BIG (ST3120). Same interface links/joints as
  shoulder_small.xacro, but the larger servo + heavier brackets from the
  mod101_large export. The three meshes are registered as ONE rigid unit
  (visual origins satisfy V_servo = V_rot - fixed_servo_shoulder and
  V_adapter = V_servo - joint_shoulder, exactly as in the small module), so the
  assembly moves together.

  The big parts are now exported in the same CAD frame as the small ones, so
  the visual origins below are the export's own and the nudge is zero: the
  adapter's rail slot straddles the 20x20 extrusion axis to within ~1.5 mm and
  the rotation link is centred on the joint_base axis to within ~1 mm — the
  same fit the small module has. Don't re-introduce a nudge to "fix" apparent
  offset; check the datums first (see below).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="mod101_shoulder_big" params="prefix">

<!-- Fine-alignment nudge for the whole big-shoulder assembly (cosmetic; shifts
     all three meshes together, kinematics unchanged). Editable live from the
     configurator's nudge panel, or by hand here.

     Zero, and it should stay zero for this export. The datums to check if you
     think it needs adjusting (all in link-local coords):
       shoulder_adapter_1  AABB centre should sit on the arm_extrusion axis,
                           i.e. (y,z) = (-0.019171, -0.001125)
       shoulder_rotation_link_1  AABB should be centred on y=0 (the joint_base
                           axis, which passes through the link origin)
     A stale non-zero nudge here was displacing the whole assembly ~26 mm. -->
<xacro:property name="snx" value="0.000000"/>
<xacro:property name="sny" value="0.000000"/>
<xacro:property name="snz" value="0.000000"/>

<link name="${prefix}shoulder_rotation_link_1">
  <inertial>
    <origin xyz="0.032744272167771385 0.0004962194281389748 -0.013844865838515547" rpy="0 0 0"/>
    <mass value="0.049583984"/>
    <inertia ixx="1.84372307e-05" iyy="2.5269301e-05" izz="2.32103209e-05" ixy="-2.80770011e-07" iyz="-1.87180007e-07" ixz="-2.33975009e-06"/>
  </inertial>
  <visual>
    <origin xyz="${-0.001130+snx} ${-0.000787+sny} ${-0.049192+snz}" rpy="0 0 0"/>
    <geometry><mesh filename="file://$(find mod101_description)/meshes/shoulder_rotation_link_big_1.stl" scale="0.001 0.001 0.001"/></geometry>
    <material name="body_darkgrey"/>
  </visual>
  <collision>
    <origin xyz="${(-0.001130+snx) + 0.0294865} ${(-0.000787+sny) + -0.000250002} ${(-0.049192+snz) + 0.03455}" rpy="0 0 0"/>
    <geometry>
      <box size="0.0809691 0.0747 0.0493"/>
    </geometry>
  </collision>
</link>

<link name="${prefix}servo_shoulder_1">
  <inertial>
    <origin xyz="-0.010248506820219064 0.016877231540248554 0.021914022574664543" rpy="0 0 0"/>
    <mass value="0.210"/>
    <inertia ixx="5.7e-05" iyy="4.5e-05" izz="3.2e-05" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="${-0.059990+snx} ${0.015210+sny} ${-0.042608+snz}" rpy="0 0 0"/>
    <geometry><mesh filename="file://$(find mod101_description)/meshes/servo_shoulder_big_1.stl" scale="0.001 0.001 0.001"/></geometry>
    <material name="motor_black"/>
  </visual>
  <collision>
    <origin xyz="${(-0.059990+snx) + 0.0547211} ${(0.015210+sny) + -0.000250002} ${(-0.042608+snz) + 0.0592}" rpy="0 0 0"/>
    <geometry>
      <box size="0.03 0.0683 0.065"/>
    </geometry>
  </collision>
</link>

<link name="${prefix}shoulder_adapter_1">
  <inertial>
    <origin xyz="-0.020137432669050628 -0.01850241218843865 0.0002933203996578482" rpy="0 0 0"/>
    <mass value="0.0407909635"/>
    <inertia ixx="1.43752861e-05" iyy="8.79941757e-06" izz="1.85571876e-05" ixy="0" iyz="0" ixz="1.74245893e-07"/>
  </inertial>
  <visual>
    <origin xyz="${-0.049740+snx} ${-0.019990+sny} ${-0.075358+snz}" rpy="0 0 0"/>
    <geometry><mesh filename="file://$(find mod101_description)/meshes/shoulder_adapter_big_1.stl" scale="0.001 0.001 0.001"/></geometry>
    <material name="body_darkgrey"/>
  </visual>
  <collision>
    <origin xyz="${(-0.049740+snx) + 0.0331519} ${(-0.019990+sny) + -0.000150002} ${(-0.075358+snz) + 0.0758}" rpy="0 0 0"/>
    <geometry>
      <box size="0.0730383 0.0747 0.0299"/>
    </geometry>
  </collision>
</link>

<joint name="${prefix}fixed_servo_shoulder_1" type="fixed">
  <origin xyz="0.05886 -0.015997 -0.006584" rpy="0 0 0"/>
  <parent link="${prefix}shoulder_rotation_link_1"/>
  <child link="${prefix}servo_shoulder_1"/>
</joint>

<joint name="${prefix}joint_shoulder" type="revolute">
  <origin xyz="-0.01025 0.0352 0.03275" rpy="0 0 0"/>
  <parent link="${prefix}servo_shoulder_1"/>
  <child link="${prefix}shoulder_adapter_1"/>
  <axis xyz="0.0 1.0 0.0"/>
  <limit upper="3.141593" lower="0.0" effort="100" velocity="100"/>
  <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
</joint>

</xacro:macro>

</robot>
