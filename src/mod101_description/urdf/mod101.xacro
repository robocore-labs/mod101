<!-- Pull in the active tool. xacro doesn't support nesting $(arg) inside
     $(find), so we list each known tool as its own conditional include.
     Add a new tool: drop in mod101_tool_<name>/ and append a branch here. -->
<xacro:if value="${'$(arg tool)' == 'parallel'}">
  <xacro:include filename="$(find mod101_tool_parallel)/urdf/tool.urdf.xacro"/>
</xacro:if>
<xacro:if value="${'$(arg tool)' == 'pincopen'}">
  <xacro:include filename="$(find mod101_tool_pincopen)/urdf/tool.urdf.xacro"/>
</xacro:if>
<xacro:if value="${'$(arg tool)' == 'none'}">
  <xacro:include filename="$(find mod101_tool_none)/urdf/tool.urdf.xacro"/>
</xacro:if>

</robot>
