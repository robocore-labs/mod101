<!-- Wrist flange: standard mount contract for tool packages. The active tool
     (selected via the `tool` xacro arg) attaches its root link here via a
     fixed joint at this origin. Z points out from the flange, X up. -->
<link name="wrist_flange">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.001"/>
    <inertia ixx="1e-06" iyy="1e-06" izz="1e-06" ixy="0" iyz="0" ixz="0"/>
  </inertial>
</link>

