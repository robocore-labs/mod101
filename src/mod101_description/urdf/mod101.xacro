    </geometry>
  </collision>
</link>

<!-- Elbow extrusion: dual 2020 rail (single URDF link representing both).
     Geometry derives from elbow_ext_length and the fixed +45 deg mount angle. -->
<link name="elbow_extrusion_1">
  <xacro:property name="L" value="${elbow_ext_length}"/>
  <xacro:property name="m" value="${2 * extrusion_density * L}"/>
  <inertial>
    <origin xyz="${L/2*cos_a} 0 ${L/2*sin_a}" rpy="0 ${ext_angle} 0"/>
    <mass value="${m}"/>
    <inertia ixx="${m*(ext_cross*ext_cross + L*L)/12}"
             iyy="${m*(ext_cross*ext_cross + L*L)/12}"
             izz="${m*(ext_cross*ext_cross + ext_cross*ext_cross)/12}"
             ixy="0" iyz="0" ixz="0"/>
  </inertial>
  <visual>
    <origin xyz="${L/2*cos_a} 0 ${L/2*sin_a}" rpy="0 ${ext_angle} 0"/>
    <geometry>
      <box size="${ext_cross} ${ext_cross} ${L}"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="${L/2*cos_a} 0 ${L/2*sin_a}" rpy="0 ${ext_angle} 0"/>
    <geometry>
      <box size="${ext_cross} ${ext_cross} ${L}"/>
    </geometry>
  </collision>
</link>

