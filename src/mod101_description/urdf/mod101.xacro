<?xml version="1.0" ?>
<robot name="mod101" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- use_sim: when true, pulls in the Gazebo ros2_control system + per-link
     gazebo extensions. Hardware overlays (mod101_control) should override
     to false. -->
<xacro:arg name="use_sim" default="true"/>

<!-- tool: which end-effector package to pull in. The arm terminates at
     `wrist_flange`; the selected tool's URDF attaches via a fixed joint at
     that link and contributes its own joints, ros2_control hardware block,
     gazebo extensions, controllers, and (separately, via the gazebo launch)
     its own launch fragment. Must match a package named
     `mod101_tool_<tool>` that ships urdf/tool.urdf.xacro. -->
<xacro:arg name="tool" default="parallel"/>

<xacro:include filename="$(find mod101_description)/urdf/materials.xacro" />
<xacro:if value="$(arg use_sim)">
  <xacro:include filename="$(find mod101_description)/urdf/mod101.ros2control" />
  <xacro:include filename="$(find mod101_description)/urdf/mod101.gazebo" />
</xacro:if>

<!-- ============================================================
     Configurable 2020 aluminum extrusion lengths.
     The web app edits ONLY these two property values; every dependent
     quantity (joint offsets, box visuals, masses, inertias) recomputes.

       shoulder_ext_length  - upper-arm rails (L and R, single 2020 each)
       elbow_ext_length     - forearm dual-rail segment (one URDF link)

     extrusion_density is the linear mass of one 2020 rail (kg/m).
     The elbow link covers two parallel rails, so its mass is 2× density × L.
     ============================================================ -->
<xacro:property name="shoulder_ext_length" value="0.0800"/>
<xacro:property name="elbow_ext_length"    value="0.0800"/>
<xacro:property name="extrusion_density"   value="0.46"/>
<xacro:property name="ext_cross"           value="0.020"/>  <!-- 20x20 mm profile -->
<xacro:property name="ext_angle"           value="${pi/4}"/> <!-- both rails mount at 45 deg -->
<xacro:property name="cos_a"               value="${cos(ext_angle)}"/>
<xacro:property name="sin_a"               value="${sin(ext_angle)}"/>

<!-- Anchor base_link to the world so the arm doesn't tip over under gravity. -->
<link name="world"/>
<joint name="world_to_base" type="fixed">
  <parent link="world"/>
  <child link="base_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<link name="base_link">
  <inertial>
    <origin xyz="-0.01099401981130007 1.3821647392049386e-05 0.013450739285809572" rpy="0 0 0"/>
    <mass value="0.03628"/>
    <inertia ixx="3.23936e-05" iyy="2.73718e-05" izz="4.10577e-05" ixy="0.0" iyz="0.0" ixz="5.68406e-06"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="body_darkgrey"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find mod101_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

