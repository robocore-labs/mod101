<?xml version="1.0"?>
<robot name="mod101" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="mod101_arm_ros2control" params="prefix">

  <ros2_control name="${prefix}mod101_sim_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Arm joints (5 DOF). End-effector joints live in the active tool's own
         <ros2_control> block; see mod101_tool_<tool>/urdf/tool.ros2control. -->
    <joint name="${prefix}joint_base">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="${prefix}joint_shoulder">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="${prefix}joint_elbow">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="${prefix}joint_wrist_tilt">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="${prefix}joint_wrist_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

</xacro:macro>

</robot>
