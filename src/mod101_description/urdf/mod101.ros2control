<?xml version="1.0"?>
<robot name="mod101" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="mod101_sim_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Arm joints (5 DOF, continuous). -->
    <joint name="1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- End-effector joints live in $(arg tool)'s own <ros2_control> block;
         see mod101_tool_<tool>/urdf/tool.ros2control. -->

  </ros2_control>

</robot>
