<?xml version="1.0"?>
<robot name="mod101" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="mod101_arm_ros2control" params="prefix">

  <ros2_control name="${prefix}mod101_sim_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- 4 actuated DOF (wrist roll is fixed in the exports; the actuated 5th
         DOF + tool flange arrive with the tool work). -->
    <joint name="${prefix}joint_base">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="${prefix}joint_shoulder">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="${prefix}joint_elbow">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="${prefix}joint_wrist_tilt">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

</xacro:macro>

</robot>
