<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mod101_moveit_config</name>
  <version>0.0.0</version>
  <description>MoveIt 2 configuration for the mod101 arm. Parametric SRDF (tool + build args), 5-DOF-aware IK, and bringup launches for sim and mock hardware.</description>
  <maintainer email="todo@todo.com">author</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>mod101_description</exec_depend>
  <exec_depend>mod101_control</exec_depend>
  <exec_depend>mod101_tool_jaws</exec_depend>
  <exec_depend>mod101_tool_parallel</exec_depend>
  <exec_depend>mod101_tool_pincopen</exec_depend>
  <exec_depend>mod101_tool_none</exec_depend>

  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>pick_ik</exec_depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
