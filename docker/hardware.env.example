# Copy to docker/.env and edit. Read by docker/hardware.compose.yaml.
#
#   cp docker/hardware.env.example docker/.env
#
# Every value below has a working default — this file exists for the cases that
# differ from this bench, not as a required step.

# The servo bus. Defaults to /dev/link101-servo, the Link101's udev name for
# its Motor endpoint, which is stable across re-enumeration. Set this only for
# a bare USB adapter or a board without those rules.
#MOD101_BUS=/dev/link101-servo

# The harness pan/tilt. false until its servos are on the bus.
MOD101_HEAD=false

# Kept apart from the sim stack, which uses domain 1. Sharing a domain would
# put a simulated controller_manager on the same graph as this real one.
ROS_DOMAIN_ID=2

# Must match between the services, and own the agent's state volume.
HOST_UID=1000
HOST_GID=1000

# The group that owns /dev/tty* on the host: `getent group dialout`.
DIALOUT_GID=20
