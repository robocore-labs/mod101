# Copy to docker/.env and edit. Read by docker/hardware.compose.yaml.
#
#   cp docker/hardware.env.example docker/.env
#
# Every value below has a working default — this file exists for the cases that
# differ from this bench, not as a required step.

# The servo bus ON THE HOST. Inside the container it is always
# /dev/mod101-servo, so this is the only place the host's name appears.
#
# Install docker/udev/99-mod101-servo.rules and you can leave this commented
# out — the rule pins the adapter by serial number, so /dev/mod101-servo lands
# on the same cable across re-enumeration and reboots.
#
# Without the rule, point it at the raw device — but know that ttyACM numbering
# is assignment order, not identity. It has already moved once on this bench,
# and the symptom of getting it wrong is not "wrong port": the port opens,
# nothing answers, and the driver refuses to start as though the motors were
# unpowered.
#MOD101_BUS=/dev/mod101-servo
#MOD101_BUS=/dev/ttyACM0

# The harness pan/tilt (servos 7 and 8). On by default. Set false when the
# tower is unplugged: the driver refuses to start unless every motor it is
# configured for answers, so an absent head takes the arm down with it.
MOD101_HEAD=true

# ---- cameras (the `cameras` service) --------------------------------------
# The RealSense D435 on the head. Needs
# docker/udev/99-mod101-realsense.rules installed on the host, because the
# service runs as your UID and librealsense wants raw USB write access.
MOD101_HEAD_CAMERA=true

# The wrist camera. No camera is fitted, and usb_cam pointed at an absent
# device starts, logs once and sits there looking healthy — so this stays off
# until there is something to open.
MOD101_WRIST_CAMERA=false
#MOD101_WRIST_DEVICE=/dev/video0

# The registered point cloud. The most expensive stream the D435 produces;
# only deproject() in the profile needs it.
MOD101_POINTCLOUD=false

# Kept apart from the sim stack, which uses domain 1. Sharing a domain would
# put a simulated controller_manager on the same graph as this real one.
ROS_DOMAIN_ID=2

# Must match between the services, and own the agent's state volume.
HOST_UID=1000
HOST_GID=1000

# The group that owns /dev/tty* on the host: `getent group dialout`.
DIALOUT_GID=20
